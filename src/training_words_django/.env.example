# Django
SECRET_KEY=secret_key
DEBUG=true
ALLOWED_HOSTS=allowed_hosts

# Postgres
POSTGRES_USE=false
DB_NAME=name
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=port

# Dropbox
APP_KEY=app_key
APP_SECRET=app_secret
REFRESH_TOKEN=token
ROOT_PATH=root_path
# add or overwrite
WRITE_MODE=overwrite

# Redis
REDIS_URL=redis://redis:6379/0

# Dropbox Storage
DROPBOX_USE=false

# logging
#INFO
#DEBUG
#WARNING
#ERROR
#CRITICAL
LOGGING_LEVEL=logginglevel

# Doman
DOMAIN=doman

# Email
# false — письма сохраняются в sent_emails;
# true — отправляются через SMTP.
USE_SMTP_EMAIL=false

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.com
EMAIL_HOST_PASSWORD=app-password
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL="Тренажёр слов <no-reply@example.com>"
