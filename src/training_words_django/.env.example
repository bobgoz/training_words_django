# Django
SECRET_KEY=secret_key
DEBUG=true
ALLOWED_HOSTS=allowed_hosts

# Postgres
POSTGRES_USE=false
DB_NAME=name
DB_USER=user
DB_PASSWORD=password
DB_HOST=db
DB_PORT=port

# Dropbox
APP_KEY=app_key
APP_SECRET=app_secret
REFRESH_TOKEN=token
ROOT_PATH=root_path
# add or overwrite
WRITE_MODE=overwrite

# Redis
REDIS_URL=redis://redis:6379/0

# Dropbox Storage
DROPBOX_USE=false
